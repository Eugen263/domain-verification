{
  "name": "express-service",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "tsoa": "tsoa spec-and-routes",
    "dev": "pnpm tsoa && tsx watch --env-file .env src/index.ts",
    "build": "pnpm tsoa && rimraf ./dist && tsc && tsc-alias",
    "start": "node --import tsx/esm dist/index.js",
    "migration:generate": "node --import tsx/esm --env-file .env ./node_modules/typeorm/cli.js migration:generate -d src/config/database.ts ./migrations/migration",
    "migration:run": "node --import tsx/esm --env-file .env ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:run:prod": "node --import tsx/esm ./node_modules/typeorm/cli.js migration:run -d dist/config/database.js",
    "kill": "lsof -i :3000 -t | xargs kill -9",
    "postinstall": "pnpm tsoa",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jiti": "^2.6.1",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "@types/pg": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "inversify": "^8.1.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "7.0.0-alpha.0",
    "tsx": "^4.21.0",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
